# Dropshipping Niche Scout configuration — copy to `.env` and adjust.
# All values are optional; sensible defaults are applied when unset.

# --- Report ---
REPORT_PRODUCT_LIMIT=5          # how many accepted products to include in the report

# --- Kalodata sourcing filters ---
KALODATA_CATEGORIES=            # comma-separated category names (blank = all)
KALODATA_PRICE_MIN=
KALODATA_PRICE_MAX=
KALODATA_REVENUE_MIN=
KALODATA_REVENUE_MAX=
KALODATA_REVENUE_PER_DAY_MIN=
KALODATA_REVENUE_WINDOW_DAYS=
KALODATA_GROWTH_MIN=
KALODATA_GROWTH_MAX=
KALODATA_MAX_PRODUCTS=
KALODATA_MAX_PAGES=
KALODATA_START_PAGE=

# --- Competition / scoring thresholds ---
FACEBOOK_CROWD_WARN_COUNT=
FACEBOOK_CROWD_REJECT_COUNT=
OFFICIAL_SHOP_ALTERNATIVE_MIN_SCORE=50

# --- Browser behavior ---
VISIBLE_BROWSER=0               # 1 = show the browser window while running
ALLOW_FOCUS_CLICK=0             # 1 = allow focus-click interactions (debugging)
